    issue_arg(pcfa)
    pcfa.add_argument("--scenario", required=True, action="append",
                      help="scenario id it traces to (repeatable)")
    pcfa.set_defaults(func=cmd_changed_file_add, output_kind="hand-off")

    pev = sub.add_parser("evidence", help="issue evidence-registry tools")
    pevs = pev.add_subparsers(dest="subcmd", required=True)
    peva = pevs.add_parser("add", help="append a typed evidence entry")
    peva.add_argument("evidence_id", help="evidence id (e.g. EV-5)")
    issue_arg(peva)
    peva.add_argument("--type", required=True, help="evidence type (see guardrails.yml)")
    peva.add_argument("--path", required=True, help="path to the evidence file")
    peva.add_argument("--scenario", help="scenario this evidence is for (optional)")
    peva.set_defaults(func=cmd_evidence_add, output_kind="hand-off")
    register_review_parser(pevs)

    register_quick_fix_parser(sub, issue_arg)
    register_decision_parser(sub)
    register_lesson_parser(sub)
    register_run_parser(sub)
    register_record_parser(sub)

    pmig = sub.add_parser(
        "migrate",
        help="migrate a 1.x issue tree to schema 2.0 - dry-run by default, "
             "--apply to execute, idempotent (wraps the core this "
             "repository's own archive migration proved)")
    pmig.add_argument("root", nargs="?",
                      help="the work root to examine (default: .compass/work)")
    pmig.add_argument("--apply", action="store_true",
                      help="execute the changes the dry run reports")
    pmig.add_argument("--i-have-a-copy", action="store_true", help="proceed where git cannot restore the work root, because you have taken a copy"); pmig.set_defaults(func=cmd_migrate, output_kind="report")

    pinit = sub.add_parser(
        "init",
        help="make this directory a Compass project - create .compass/ "
             "(safe to run twice)")
    pinit.add_argument("--by", help="what is initialising - the entry-point command, if not a person")
    pinit.set_defaults(func=cmd_init, output_kind="hand-off")
    pterm = sub.add_parser(
        "terminology",
        help="render the v2 vocabulary - one term, or the whole glossary "
             "(governance/terminology.yml is the single source of truth)")
    pterm.add_argument("term", nargs="?",
                       help="the term to render (omit to list every term)")
    pterm.set_defaults(func=cmd_terminology, output_kind="report")

    # --- private entry point ---------------------------------
    # The leading underscore in the name is the convention that marks a
    # subcommand as private (in-framework callers only).
    # We register it via add_parser(help=SUPPRESS) to hide it from the
    # subcommand help listing, and then manually remove it from the
    # _choices_actions list so it also disappears from the usage line and the
    # {choices} display.  This keeps private verbs out of the public verb set
    # that `tests/cross_cutting/test_stream_d_invariants.py` pins.
    p_derive = sub.add_parser(
        "_derive-system-spec",
        help=argparse.SUPPRESS,
    )
    p_derive.add_argument(
        "--internal",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    p_derive.set_defaults(func=cmd_derive_system_spec, output_kind="report")

    # docs/glossary.md is generated from governance/terminology.yml. Private
    # and called at ship, the same shape as _derive-system-spec: it adds no
    # public verb.
    p_gloss = sub.add_parser("_derive-glossary", help=argparse.SUPPRESS)
    p_gloss.add_argument("--internal", action="store_true", help=argparse.SUPPRESS)
    p_gloss.add_argument("--out", help=argparse.SUPPRESS)
    p_gloss.add_argument("--root", help=argparse.SUPPRESS)
    p_gloss.set_defaults(func=cmd_derive_glossary, output_kind="report")

    # Private entry point for the archive migration core that `compass
    # migrate` wraps. Hidden like its siblings.
    p_marc = sub.add_parser("_migrate-archive", help=argparse.SUPPRESS)
    p_marc.add_argument("--internal", action="store_true", help=argparse.SUPPRESS)
    p_marc.add_argument("roots", nargs="*", help=argparse.SUPPRESS)
    from compass_pkg.migrate import cmd_migrate_archive as _cmd_marc
    p_marc.set_defaults(func=_cmd_marc, output_kind="hand-off")

    # Private entry point for the friction-capture step of ship, called by
    # `commands/ship.md`. It adds no public verb.
    p_fric = sub.add_parser("_friction-capture", help=argparse.SUPPRESS)
    p_fric.add_argument("--internal", action="store_true", help=argparse.SUPPRESS)
    p_fric.add_argument("--issue", dest="task", metavar="SLUG", help=argparse.SUPPRESS)
    p_fric.add_argument("--note", help=argparse.SUPPRESS)
    p_fric.add_argument("--note-category", dest="note_category",
                        help=argparse.SUPPRESS)
    p_fric.add_argument("--note-phase", dest="note_phase", help=argparse.SUPPRESS)
    p_fric.set_defaults(func=cmd_friction_capture, output_kind="hand-off")

    # Private entry point that renders one refusal from the registry in
    # cli/compass_pkg/refusals.py. hooks/pre-tool.sh calls it at every
    # refusal site python3 is known to be running for, so a refusal's
    # wording lives in one place instead of being hand-written per call
    # site. `--list` renders every code's template, unfilled, for
    # docs/refusal-codes.md.
    p_ref = sub.add_parser("_refusal", help=argparse.SUPPRESS)
    p_ref.add_argument("code", nargs="?", help=argparse.SUPPRESS)
    p_ref.add_argument("params", nargs="*", help=argparse.SUPPRESS)
    p_ref.add_argument("--list", action="store_true", help=argparse.SUPPRESS)
    from compass_pkg.refusals import cmd_refusal as _cmd_refusal
    p_ref.set_defaults(func=_cmd_refusal, output_kind="hand-off")
    # Hide all private (leading-underscore) subcommands from --help output:
    #   1. Remove from _choices_actions  →  hides from the positional-args
    #      listing section in the help text.
    #   2. Override metavar on the subparsers action  →  hides from the
    #      usage line (which uses the metavar string for display).
    # The parsers remain in sub.choices/_name_parser_map so they can still
    # be invoked; they just do not surface in the public help surface.
    # This keeps private verbs out of the public verb set that
    # `tests/cross_cutting/test_stream_d_invariants.py` pins.
    sub._choices_actions = [
        a for a in sub._choices_actions
        if not a.dest.startswith("_")
    ]
    # Verbs that still work but are no longer taught. A retired spelling that
    # shipped in a released version cannot simply stop working inside a major
    # version - ADR-006 - but it must not appear in `--help` either, or every
    # teaching surface has to document a name the reader should not use.
    #
    # Empty now. Kept because a future retirement needs the mechanism;
    # ADR-024 says why nothing is in it.
    hidden = set()
    # A stale entry here is otherwise silent: `hidden` is only ever subtracted
    # from the advertised list, so naming a verb that does not parse removes
    # nothing and reports nothing. Checked against the parser rather than by
    # reading this file's source, so it survives any reformatting of the line
    # above and fires for every caller.
    unknown = hidden - set(sub.choices)
    if unknown:
        raise CompassError(
            "cli/compass: the `hidden` verb set names %s, which the parser "
            "does not define. Every name in `hidden` must be a real verb - "
            "the set exists to keep a verb out of --help, not to list "
            "spellings that no longer exist."
            % ", ".join(sorted(unknown)))
    public_names = [k for k in sub.choices
                    if not k.startswith("_") and k not in hidden]
    sub.metavar = "{" + ",".join(public_names) + "}"

    # The five output flags, added to every leaf verb at once. The output KIND
    # is deliberately NOT set here - see attach_mode_flags in terminal.py.
    attach_mode_flags(p)

    apply_descriptions(p)   # what each verb claims about itself - verb_help.py

    return p




def main(argv=None):
    raw = list(sys.argv[1:]) if argv is None else list(argv)
    # A retired v1 verb is an unrecognised verb, and argparse reports it
    # (ADR-014). An unknown option is reported against its own verb.
    from compass_pkg.verb_help import parse_command_line
    args = parse_command_line(build_parser(), raw)
    # tdd-red/green: strip a leading "--" that argparse REMAINDER keeps
    if getattr(args, "command", None) and args.command and args.command[0] == "--":
        args.command = args.command[1:]
    try:
        return run_with_mode(args, lambda a: args.func(a) or 0) or 0
    except CompassError as exc:
        # Paths in an error open from the project root, like every other
        # path the CLI prints (#293).
        from compass_pkg.terminal import relative_to_project
        sys.stderr.write(f"compass: {relative_to_project(str(exc))}\n")
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
