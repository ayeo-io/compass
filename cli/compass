#!/usr/bin/env python3
"""The Compass CLI entry point.

The commands live in `compass_pkg/`; this file holds the shebang, the
argument parser and main(). It re-exports every public name the package
defines, so anything that loads this file by path, such as the test suite,
finds every public name in the package.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
# Runs cli/compass_pkg/__init__.py, which puts the bundled PyYAML at
# sys.path[0] - before the `import yaml` below, so it is the copy this
# process resolves rather than whatever the machine happens to have (or not
# have). This is the ONE place that side effect is triggered for this entry
# point; see cli/compass_pkg/__init__.py for where the path itself is written.
import compass_pkg  # noqa: E402,F401

# =============================================================================
# compass - the Compass CLI
# =============================================================================
# The deterministic half of Compass. A person or an agent gives the
# four-dimension assessment - that is judgement. Everything downstream of the
# assessment is mechanical, and this is where the mechanism lives. Each
# verb's description is in `cli/compass_pkg/verb_help.py`.
#
# DEPENDENCY: PyYAML, bundled at cli/vendor/yaml/ and pinned in
# THIRD-PARTY-NOTICES.md. cli/compass_pkg/__init__.py resolves it, and it is
# the only third-party code Compass ships; everything else is the Python 3
# standard library.
#
# GOVERNANCE RESOLUTION: the CLI looks for a project-local `governance/`
# (walking up from the working directory); if there is none, it falls back to
# the framework's shipped `governance/` next to this script. The fallback
# means the shipped defaults work with no project setup.
# =============================================================================

