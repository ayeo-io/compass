{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://compass.dev/schemas/execution-profile.schema.json",
  "title": "profiles/<id>.<version>.yml",
  "description": "One execution profile file: a fixed, versioned way of working. This schema states structure and formats only. The model tiers, the effort levels and the runner ceilings come from cli/compass_pkg/model_tiers.py and the routing policy, and the code in cli/compass_pkg/execution_profile.py is the authority. Only tests check files against this schema. docs/execution-profiles.md describes the rules.",
  "type": "object",
  "required": ["schema", "id", "version", "digest", "parent", "owner", "approval", "applies_to", "runner_versions", "model", "components", "runner_settings"],
  "additionalProperties": false,
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "text": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "required": ["state", "by", "at"],
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/definitions/text"},
        "by": {"type": ["string", "null"], "minLength": 1},
        "at": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "reference": {
      "type": "object",
      "required": ["id", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/text"},
        "revision": {"$ref": "#/definitions/digest"}
      }
    },
    "references": {"type": "array", "items": {"$ref": "#/definitions/reference"}}
  },
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/definitions/name"},
    "version": {"type": "integer", "minimum": 1},
    "digest": {"$ref": "#/definitions/digest"},
    "parent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["version", "digest"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "integer", "minimum": 1},
            "digest": {"$ref": "#/definitions/digest"}
          }
        }
      ]
    },
    "owner": {"$ref": "#/definitions/text"},
    "approval": {"$ref": "#/definitions/approval"},
    "applies_to": {
      "type": "object",
      "required": ["task_classes", "repositories"],
      "additionalProperties": false,
      "properties": {
        "task_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/name"}},
        "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}}
      }
    },
    "runner_versions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
    },
    "model": {
      "type": "object",
      "required": ["tier", "effort", "provider_revision"],
      "additionalProperties": false,
      "properties": {
        "tier": {"type": "string"},
        "effort": {"type": "string"},
        "provider_revision": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "components": {
      "type": "object",
      "required": ["skills", "prompt_fragments", "tool_guidance"],
      "additionalProperties": false,
      "properties": {
        "skills": {"$ref": "#/definitions/references"},
        "prompt_fragments": {"$ref": "#/definitions/references"},
        "tool_guidance": {"$ref": "#/definitions/references"}
      }
    },
    "runner_settings": {
      "type": "object",
      "required": ["max_cycles", "max_minutes", "max_cost_usd"],
      "additionalProperties": false,
      "properties": {
        "max_cycles": {"type": "integer", "minimum": 1},
        "max_minutes": {"type": "number", "exclusiveMinimum": 0},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
